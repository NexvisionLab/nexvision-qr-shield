# Optional path to a local, administrator-maintained blocklist.
# The application never downloads or uploads this file.
QR_SHIELD_BLOCKLIST=
QR_SHIELD_ENV=production
QR_SHIELD_ALLOWED_HOSTS=localhost,127.0.0.1
# Use two different randomly generated values. Each must have at least
# 32 characters, 12 distinct characters and 128 estimated entropy bits.
QR_SHIELD_API_KEY=
QR_SHIELD_REPORT_HMAC_KEY=
QR_SHIELD_ALLOW_NETWORK_PREFLIGHT=0
QR_SHIELD_OCR=1
QR_SHIELD_REDACTION_LEVEL=personal
